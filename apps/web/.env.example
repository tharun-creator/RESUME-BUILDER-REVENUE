# Public, non-secret frontend env for apps/web.
# The Razorpay key id is the ONLY key allowed in the frontend (never the key secret).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# Wave 2: base URL of the real API. The mocked API layer in src/mocks is used
# until the backend exists (T-U2 rewires these calls).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
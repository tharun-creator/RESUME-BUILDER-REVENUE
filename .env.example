# ATS Resume Score Checker - environment variables (PLACEHOLDERS ONLY)
# Copy to .env and fill real values locally. Never commit real secrets.

# --- Database (PRD §8, §10) ---
DATABASE_URL=postgresql://ats_dev:local-dev-only@localhost:5433/ats_dev

# --- Redis: queue, cache, sessions, rate limits (PRD §8, §11) ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible storage (MinIO local / S3 or R2 prod) (PRD §8, §9, §12) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=ats-resumes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Auth / session (PRD §7.1, §12) ---
SESSION_SECRET=replace-with-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Razorpay (PRD §7.6, §10) ---
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# --- AI (PRD §7.3, §9) ---
CLAUDE_API_KEY=replace-me
CLAUDE_MODEL_SCORING=claude-3-5-haiku-latest
CLAUDE_MODEL_REWRITE=claude-3-5-sonnet-latest

# --- Email (PRD §7.5, §9) ---
RESEND_API_KEY=replace-me
EMAIL_FROM="ATS Checker <noreply@example.com>"

# --- Observability (PRD §12) ---
SENTRY_DSN=

# --- App config (PRD §11, §17.3 - retention default 24h proposed) ---
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
FILE_RETENTION_HOURS=24
DAILY_AI_SPEND_CAP_INR=500
NODE_ENV=development
